// Complete DP-1 override comes first: output blocks use first-match resolution.
// Copied from this host's cfg/outputs.kdl; synchronize future output changes here.
output "DP-1" {
    mode "3840x2160@60.000"
    scale 1.75
    position x=0 y=0
    focus-at-startup
    hot-corners { bottom-right; }
    hdr mode="auto"
}

include @USER_CONFIG@

// Keep the original application's transparency and all other window rules.
// These applications already request ordinary blur in the user's configuration.
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    match app-id="^Alacritty$"
    match app-id="^foot$"
    match app-id="^org.gnome.Console$"
    match app-id="^dev.zed.Zed$"
    match app-id="^nwg-look$"
    match app-id="^moe.tsuna.tsukimi$"
    match app-id="^app.liten.Gram$"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
        liquid-glass {
            refraction-strength 3
            power-factor 10
            refraction-power 1
            physical-refraction 0
            lens-distortion 0
            glow-weight 0.0001
            edge-lighting 0.2
            fringing 0
            saturation 0.9
            vibrancy 0.2
            adaptive-dim 0.2
            adaptive-boost 0.2
        }
    }
}
